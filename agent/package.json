{
  "name": "screenwatch-agent",
  "version": "1.0.0",
  "description": "ScreenWatch Agent - Captura de tela para monitoramento corporativo",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "node-machine-id": "^1.1.12",
    "screenshot-desktop": "^1.15.0",
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.screenwatch.agent",
    "productName": "ScreenWatch Agent",
    "win": {
      "target": "portable",
      "certificateFile": null,
      "verifyUpdateCodeSignature": false
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
